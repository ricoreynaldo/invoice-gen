{
  "name": "beresin-invoice",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "fonts": "node scripts/build-fonts.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "dev:emulator": "node scripts/firebase.mjs emulators:exec --project demo-beresin --only auth,firestore \"astro dev --mode emulator\"",
    "test:rules": "node scripts/firebase.mjs emulators:exec --project demo-beresin --only firestore \"node --test tests/rules.spec.ts\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "firebase": "^13.0.0",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "firebase-tools": "^15.34.0",
    "jsqr": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
