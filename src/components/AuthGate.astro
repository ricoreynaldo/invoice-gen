---
// Layar penutup sampai admin terverifikasi. Isinya diatur src/scripts/session.ts.
// Ini hanya UX; keamanan data dijaga firestore.rules.
---

<div id="auth-gate" class="fixed inset-0 z-50 grid place-items-center overflow-y-auto bg-ink-50 px-4 py-10">
  <div class="w-full max-w-sm">
    <p class="mb-8 text-center text-[26px] font-bold tracking-[-0.01em] text-ink-900">BERESIN</p>
    <div class="card p-6 sm:p-7">
      <div data-gate="loading">
        <p class="text-center text-sm text-ink-500">Memeriksa sesi…</p>
      </div>

      <div data-gate="signin" hidden>
        <h1 class="text-lg font-semibold text-ink-900">Masuk admin</h1>
        <p class="mt-1 text-sm text-ink-500">Invoice Generator & arsip invoice Beresin.</p>
        <button type="button" class="btn btn-primary btn-md mt-6 w-full" data-gate-signin>
          <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M21.35 11.1H12v2.9h5.35c-.23 1.5-1.68 4.4-5.35 4.4-3.22 0-5.85-2.67-5.85-5.95S8.78 6.5 12 6.5c1.83 0 3.06.78 3.76 1.45l2.57-2.47C16.68 3.96 14.53 3 12 3 7.03 3 3 7.03 3 12s4.03 9 9 9c5.2 0 8.64-3.65 8.64-8.8 0-.59-.06-1.04-.14-1.5Z"
            ></path></svg
          >
          Masuk dengan Google
        </button>
        <p class="mt-3 text-center text-xs text-ink-500">Hanya akun admin Beresin yang bisa masuk.</p>
      </div>

      <div data-gate="denied" hidden>
        <h1 class="text-lg font-semibold text-ink-900">Akses ditolak</h1>
        <p class="mt-1 text-sm leading-relaxed text-ink-600">
          Akun <strong class="font-semibold text-ink-900" data-gate-email></strong> tidak terdaftar sebagai admin Beresin.
        </p>
        <button type="button" class="btn btn-outline btn-md mt-6 w-full" data-gate-signout>Masuk dengan akun lain</button>
      </div>

      <div data-gate="setup" hidden>
        <h1 class="text-lg font-semibold text-ink-900">Firebase belum dikonfigurasi</h1>
        <p class="mt-1 text-sm leading-relaxed text-ink-600">
          Isi variabel <code class="rounded bg-ink-100 px-1 text-[13px]">PUBLIC_FIREBASE_*</code> (lihat
          <code class="rounded bg-ink-100 px-1 text-[13px]">.env.example</code>) lalu build ulang.
        </p>
      </div>

      <p class="field-error mt-4 text-center" data-gate-error role="alert" hidden></p>
    </div>
  </div>
</div>
