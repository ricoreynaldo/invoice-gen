---
// Dialog konfirmasi + toast yang dipakai bersama (src/scripts/ui.ts).
import Icon from "./Icon.astro";
---

<dialog
  id="confirm-dialog"
  class="m-auto w-[min(26rem,calc(100vw-2rem))] rounded-2xl border border-ink-200 bg-white p-0 text-ink-800 shadow-xl"
  aria-labelledby="confirm-title"
>
  <form method="dialog" class="p-5 sm:p-6">
    <h2 id="confirm-title" class="text-base font-semibold text-ink-900" data-title></h2>
    <p class="mt-2 text-sm leading-relaxed text-ink-600" data-body></p>
    <div class="mt-5 flex justify-end gap-2">
      <button value="cancel" class="btn btn-outline btn-md" autofocus>Batal</button>
      <button value="confirm" class="btn btn-md" data-confirm></button>
    </div>
  </form>
</dialog>

<div
  id="toast"
  class="fixed inset-x-4 bottom-24 z-40 mx-auto flex max-w-md items-center gap-3 rounded-xl bg-ink-900 px-4 py-3 text-sm text-white shadow-lg lg:bottom-6"
  role="status"
  aria-live="polite"
  hidden
>
  <span data-icon-ok><Icon name="check" class="size-4 shrink-0" /></span>
  <span data-icon-err hidden><Icon name="alert" class="size-4 shrink-0 text-accent-200" /></span>
  <p class="min-w-0 flex-1 break-words" data-text></p>
  <button type="button" class="shrink-0 rounded-lg px-2 py-1 font-semibold underline-offset-2 hover:underline" data-action hidden></button>
</div>
