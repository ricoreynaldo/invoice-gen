---
import Base from "../layouts/Base.astro";
import AppHeader from "../components/AppHeader.astro";
import AuthGate from "../components/AuthGate.astro";
import Feedback from "../components/Feedback.astro";
import Icon from "../components/Icon.astro";

// Beranda: titik awal setelah login. Admin memilih dulu mau membuat invoice,
// melanjutkan draft, atau membuka arsip, supaya tidak langsung dihadapkan ke form.
const STEPS = [
  { title: "Isi data", body: "Customer, layanan yang dikerjakan, dan nominal pembayaran." },
  { title: "Cek preview", body: "Tampilan invoice A4 diperbarui otomatis saat mengetik." },
  { title: "Simpan & unduh", body: "Tekan Simpan agar masuk arsip, lalu PDF untuk dikirim ke customer." },
];
---

<Base title="Beranda · Beresin Invoice" description="Buat invoice transaksi customer Beresin dan unduh sebagai PDF.">
  <AppHeader active="home" />

  <!--
    Mobile/tablet: satu kolom (sapaan, draft, aksi, langkah, invoice terakhir).
    Desktop (lg): kolom kiri untuk aksi, kolom kanan untuk invoice terakhir.
  -->
  <main class="container-app pt-6 pb-16 sm:pt-10 lg:pt-12">
    <div class="grid gap-x-8 gap-y-9 lg:grid-cols-[minmax(0,1fr)_20rem] xl:grid-cols-[minmax(0,1fr)_26rem] xl:gap-x-12">
      <div class="min-w-0">
        <div class="mb-6 sm:mb-8">
          <p class="text-sm text-ink-500 sm:text-[15px]" id="greeting">Selamat datang</p>
          <h1 class="mt-1 text-[26px] leading-tight font-bold tracking-[-0.02em] text-ink-900 sm:text-[32px]">Mau buat invoice?</h1>
          <p class="mt-1.5 max-w-xl text-sm text-ink-500 sm:text-[15px]">
            Pilih salah satu di bawah. Form invoice baru terbuka setelah kamu menekan tombolnya.
          </p>
        </div>

        <!-- Draft yang belum selesai; diisi src/scripts/home.ts -->
        <a
          href="/buat"
          id="draft-card"
          class="card mb-3 flex items-center gap-3 border-ink-900 p-4 transition-colors hover:bg-ink-50 sm:mb-4 sm:gap-4 sm:p-5"
          hidden
        >
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-ink-100 text-ink-800"><Icon name="pencil" class="size-[18px]" /></span>
          <span class="min-w-0 flex-1">
            <span class="block text-[11px] font-semibold tracking-wide text-ink-500 uppercase sm:text-xs" data-draft-label>Draft belum selesai</span>
            <span class="mt-0.5 block truncate text-[15px] font-semibold text-ink-900" data-draft-title></span>
            <span class="flex flex-col text-[13px] text-ink-500 tabular-nums sm:flex-row sm:gap-x-1.5">
              <span data-draft-number></span>
              <span class="hidden sm:inline" aria-hidden="true">·</span>
              <span data-draft-status></span>
            </span>
          </span>
          <span class="btn btn-outline btn-sm pointer-events-none hidden sm:inline-flex">Lanjutkan<Icon name="arrow" class="size-3.5" /></span>
          <span class="text-ink-400 sm:hidden"><Icon name="arrow" /></span>
        </a>

        <div class="grid gap-3 sm:grid-cols-2 sm:gap-4">
          <a
            href="/buat?new=1"
            class="group flex items-center gap-4 rounded-2xl bg-ink-900 p-4 text-white transition-colors hover:bg-black sm:min-h-52 sm:flex-col sm:items-start sm:justify-between sm:gap-8 sm:p-6"
          >
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-white/10"><Icon name="plus" class="size-5" /></span>
            <span class="min-w-0 flex-1 sm:flex-none">
              <span class="flex items-center gap-2 text-base font-semibold sm:text-lg">
                Buat invoice baru
                <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-0.5" />
              </span>
              <span class="mt-0.5 block text-[13px] leading-relaxed text-white/65 sm:mt-1 sm:text-sm">
                Nomor dan tanggal invoice diisi otomatis. Kamu tinggal isi customer dan layanan.
              </span>
            </span>
          </a>

          <a
            href="/arsip"
            class="card group flex items-center gap-4 p-4 transition-colors hover:border-ink-400 sm:min-h-52 sm:flex-col sm:items-start sm:justify-between sm:gap-8 sm:p-6"
          >
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-ink-100 text-ink-800"><Icon name="archive" class="size-5" /></span>
            <span class="min-w-0 flex-1 sm:flex-none">
              <span class="flex items-center gap-2 text-base font-semibold text-ink-900 sm:text-lg">
                Buka arsip
                <Icon name="arrow" class="size-4 text-ink-500 transition-transform group-hover:translate-x-0.5" />
              </span>
              <span class="mt-0.5 block text-[13px] leading-relaxed text-ink-500 sm:mt-1 sm:text-sm">
                Cari invoice lama, unduh ulang PDF, atau ubah status DP jadi Lunas.
              </span>
            </span>
          </a>
        </div>

        <section class="mt-9 sm:mt-10" aria-labelledby="steps-title">
          <h2 id="steps-title" class="mb-3 text-sm font-semibold text-ink-900">Cara membuat invoice</h2>
          <ol class="grid divide-y divide-dashed divide-ink-300 rounded-2xl border border-dashed border-ink-300 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            {
              STEPS.map((s, i) => (
                <li class="flex gap-3 p-4">
                  <span class="grid size-6 shrink-0 place-items-center rounded-full bg-ink-900 text-[11px] font-semibold text-white tabular-nums">
                    {i + 1}
                  </span>
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold text-ink-900">{s.title}</span>
                    <span class="mt-0.5 block text-[13px] leading-relaxed text-ink-500">{s.body}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <section class="min-w-0 lg:sticky lg:top-6 lg:self-start" aria-labelledby="recent-title">
        <div class="mb-3 flex items-center justify-between gap-3">
          <h2 id="recent-title" class="text-sm font-semibold text-ink-900">Invoice terakhir</h2>
          <a href="/arsip" class="-my-1 rounded-lg px-1.5 py-1 text-[13px] font-medium text-ink-600 hover:text-ink-900" id="recent-all" hidden
            >Lihat semua</a
          >
        </div>
        <div class="card overflow-hidden">
          <p id="recent-state" class="px-4 py-10 text-center text-sm text-ink-500">Memuat…</p>
          <ul id="recent-list" class="divide-y divide-ink-100"></ul>
        </div>
      </section>
    </div>
  </main>

  <Feedback />
  <AuthGate />
</Base>

<script>
  import "../scripts/home.ts";
</script>
