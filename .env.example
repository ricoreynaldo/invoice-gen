# Config web app dari Firebase console → Project settings → Your apps → Web.
# Nilai ini bukan rahasia (keamanan diatur oleh firestore.rules), tapi jangan
# di-commit kalau repo publik supaya tidak dipakai project lain.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
