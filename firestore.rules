rules_version = '2';

// Beresin Invoice: hanya admin yang boleh membaca/menulis.
// Admin = beresincorp@gmail.com, ditambah email yang punya dokumen di
// koleksi admins/{email} (dibuat manual lewat Firebase console).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'beresincorp@gmail.com'
            || exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // Daftar admin tambahan: hanya dibaca, dikelola dari console.
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Counter nomor invoice per tanggal: counters/YYYYMMDD { last }.
    // Hanya boleh naik tepat satu, jadi nomor tidak pernah dipakai dua kali.
    match /counters/{day} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && day.matches('^[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['last', 'updatedAt'])
        && request.resource.data.last == 1;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['last', 'updatedAt'])
        && request.resource.data.last == resource.data.last + 1;
      allow delete: if false;
    }

    function validItems(items) {
      return items is list && items.size() >= 1 && items.size() <= 60;
    }

    function validInvoice(d, number) {
      return d.number == number
        && d.issueDate is string && d.issueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.status in ['unpaid', 'dp', 'paid']
        && d.customerName is string && d.customerName.size() >= 1 && d.customerName.size() <= 80
        && d.customerNameLower is string
        && d.customerWhatsapp is string && d.customerWhatsapp.size() <= 20
        && validItems(d.items)
        && d.notes is string && d.notes.size() <= 600
        && d.profile is map
        && d.totals is map
        && d.totals.total is number && d.totals.total >= 0
        && d.totals.paid is number && d.totals.paid >= 0 && d.totals.paid <= d.totals.total
        && d.totals.balance is number && d.totals.balance >= 0
        && d.history is list && d.history.size() <= 50
        && d.revision is int
        && d.updatedBy == request.auth.token.email
        && d.updatedAt == request.time;
    }

    // Arsip invoice. ID dokumen = nomor invoice.
    match /invoices/{number} {
      allow read, delete: if isAdmin();
      allow create: if isAdmin()
        && number.matches('^INV-BRS-[0-9]{8}-[0-9]{3,}$')
        && validInvoice(request.resource.data, number)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if isAdmin()
        && validInvoice(request.resource.data, number)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }
  }
}
